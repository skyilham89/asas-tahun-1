#!/usr/bin/env bash
# Verifies the dev server is reachable.
set -euo pipefail

set -a
. "$(dirname "$0")/env"
set +a

for i in $(seq 1 30); do
  if curl -fsS "http://localhost:${PORT}/" >/dev/null 2>&1; then
    echo "verify: dev server is up on port ${PORT}"
    exit 0
  fi
  sleep 1
done

echo "verify: dev server did not respond on port ${PORT}" >&2
exit 1
